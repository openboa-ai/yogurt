<template name="yg-receipt" args="title original_id detail">
  <column gap="@{gap-inline}">
  <text size="heading">{title}</text>
  <text size="sm" foreground="text_muted">{original_id}</text>
  <text>{detail}</text>
  <button variant="secondary" on-press="lookup_original">Check original request</button>
  </column>
</template>
