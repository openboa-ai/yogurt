<template name="yg-resizable" args="label summary height=0">
  <split height="{height}" label="{label}" value="{fraction}" on-resize="adjust" gap="@{gap-inline}">
    <panel background="surface" padding="@{inset-regular}"><text>{summary}</text></panel>
    <panel background="background" padding="@{inset-regular}"><slot/></panel>
  </split>
</template>
