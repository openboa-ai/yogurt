<template name="yg-popover" args="label">
  <row main="start">
    <stack>
      <button variant="secondary" on-press="open_choices">{label}</button>
      <if test="{is_open}">
        <popover anchor="below" anchor-offset="@{offset-layer}" label="{label}" on-dismiss="dismiss" padding="@{inset-regular}">
          <slot/>
        </popover>
      </if>
    </stack>
  </row>
</template>
