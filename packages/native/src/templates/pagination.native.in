<template name="yg-pagination" args="summary">
  <pagination gap="@{gap-inline}" cross="center">
  <button variant="ghost" size="sm" disabled="{at_first}" on-press="previous_page">Previous</button>
  <text>{summary}</text>
  <button variant="ghost" size="sm" disabled="{at_last}" on-press="next_page">Next</button>
  </pagination>
</template>
