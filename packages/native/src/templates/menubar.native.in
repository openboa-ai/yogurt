<template name="yg-menubar" args="label">
  <column gap="@{gap-inline}">
    <row label="{label}" gap="@{gap-tight}" cross="center">
      <for each="menus" key="id" as="item">
        <button variant="ghost" on-press="open_menu:{item.id}">{item.title}</button>
      </for>
    </row>
    <if test="{is_open}">
      <dropdown-menu label="{label}" on-dismiss="dismiss">
        <for each="choices" key="id" as="item">
          <menu-item selected="{item.selected}" disabled="{item.disabled}" on-press="choose:{item.id}">{item.title}</menu-item>
        </for>
      </dropdown-menu>
    </if>
  </column>
</template>
