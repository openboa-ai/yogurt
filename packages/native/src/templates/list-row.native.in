<template name="yg-list-row" args="label detail">
  <list-item on-press="activate" label="{label}" padding="@{list-row-inset}">
    <column gap="@{space.2}">
      <text wrap="true">{label}</text>
      <text size="sm" foreground="text_muted" wrap="true">{detail}</text>
    </column>
  </list-item>
</template>
