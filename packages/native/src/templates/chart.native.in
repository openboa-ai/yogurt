<template name="yg-chart" args="label source legend= default_series=true">
  <column gap="@{gap-stack}">
    <row gap="@{gap-inline}" cross="center">
      <text size="heading" grow="1" wrap="true">{label}</text>
      <text size="sm" foreground="text_muted">{legend}</text>
    </row>
    <if test="{default_series}">
      <chart label="{label}" height="160" grid-lines="3" stroke-width="2">
        <series kind="line" values="{samples}" color="text" label="{label}"/>
      </chart>
      <text size="sm" foreground="text_muted" wrap="true">{source}</text>
    </if>
    <slot/>
  </column>
</template>
