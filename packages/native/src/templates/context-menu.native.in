<template name="yg-context-menu" args="label">
  <stack>
    <button variant="ghost" on-press="open_choices">{label}</button>
    <if test="{is_open}">
      <dropdown-menu anchor="below" label="{label}" on-dismiss="dismiss">
        <for each="choices" key="id" as="item">
          <menu-item selected="{item.selected}" disabled="{item.disabled}" on-press="choose:{item.id}">{item.title}</menu-item>
        </for>
      </dropdown-menu>
    </if>
  </stack>
</template>
