<template name="yg-dialog" args="title">
  <dialog label="{title}" on-dismiss="dismiss" width="@{dialog-width}" padding="@{inset-sheet}">
    <column gap="@{gap-stack}">
      <row gap="@{gap-inline}" cross="center">
        <text size="heading" grow="1" wrap="true">{title}</text>
        <button variant="ghost" size="icon" icon="x" label="Close" on-press="dismiss"/>
      </row>
      <slot/>
    </column>
  </dialog>
</template>
