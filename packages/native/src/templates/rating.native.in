<template name="yg-rating" args="label">
  <column gap="@{gap-inline}">
    <text size="sm">{label}</text>
    <radio-group label="{label}">
      <for each="choices" key="id" as="item">
        <radio checked="{item.selected}" disabled="{item.disabled}" on-toggle="choose:{item.id}">{item.title}</radio>
      </for>
    </radio-group>
  </column>
</template>
