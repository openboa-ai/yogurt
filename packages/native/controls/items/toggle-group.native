<template name="yg-toggle-group" args="label">
  <toggle-group label="{label}" gap="2" padding="2">
    <for each="choices" key="id" as="item">
      <toggle-button variant="ghost" selected="{item.selected}" disabled="{item.disabled}" on-toggle="choose:{item.id}">{item.title}</toggle-button>
    </for>
  </toggle-group>
</template>
