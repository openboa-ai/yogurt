<template name="yg-stepper" args="label">
  <column label="{label}" gap="12">
    <for each="choices" key="id" as="item">
      <row gap="8" cross="center">
        <if test="{item.selected}"><badge>Current</badge></if>
        <column gap="2">
          <text>{item.title}</text>
          <text size="sm" foreground="text_muted">{item.detail}</text>
        </column>
      </row>
    </for>
  </column>
</template>
