<template name="yg-agent-row" args="label image_id detail summary item_id selected unread disabled time=">
  <list-item label="{label}" selected="{selected}" disabled="{disabled}" on-press="select_agent:{item_id}" gap="12" cross="center" padding="8">
    <image label="Agent silhouette" image="{image_id}" width="36" height="36"/>
    <column grow="1" gap="2">
      <row cross="center">
        <text grow="1" wrap="true">{label}</text>
        <text size="sm" foreground="text_muted"><span scale="0.923076923">{time}</span></text>
      </row>
      <row gap="8" cross="center">
        <text size="sm" foreground="text_muted"><span scale="0.923076923">{detail}</span></text>
        <if test="{unread}"><text size="sm"><span scale="0.923076923">Unread</span></text></if>
      </row>
      <text size="sm" foreground="text_muted"><span scale="0.923076923">{summary}</span></text>
    </column>
  </list-item>
</template>
