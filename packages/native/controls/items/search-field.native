<template name="yg-search-field" args="label value autofocus=false">
  <column gap="6">
    <text size="sm">{label}</text>
    <row gap="4" cross="center">
      <search-field grow="1" label="{label}" text="{value}" on-input="edit" autofocus="{autofocus}"/>
      <button variant="ghost" icon="x" label="Clear search" on-press="clear"/>
    </row>
  </column>
</template>
