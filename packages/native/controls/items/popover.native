<template name="yg-popover" args="label">
  <row main="start">
    <stack>
      <button variant="secondary" on-press="open_choices">{label}</button>
      <if test="{is_open}">
        <popover anchor="below" anchor-offset="6" label="{label}" on-dismiss="dismiss" padding="12">
          <slot/>
        </popover>
      </if>
    </stack>
  </row>
</template>
