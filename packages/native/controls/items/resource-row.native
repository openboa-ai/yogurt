<template name="yg-resource-row" args="label detail summary item_id selected disabled pinned can_pin">
  <row gap="8" cross="center">
    <list-item grow="1" label="{label}" selected="{selected}" disabled="{disabled}" on-press="open_resource:{item_id}" padding="8">
      <column gap="4">
        <text>{label}</text>
        <text size="sm" foreground="text_muted">{summary}</text>
        <text size="sm" foreground="text_muted">{detail}</text>
      </column>
    </list-item>
    <if test="{can_pin}"><toggle-button label="Pin {label}" selected="{pinned}" disabled="{disabled}" on-toggle="toggle_resource_pin:{item_id}">Pin</toggle-button></if>
  </row>
</template>
