<template name="yg-carousel" args="label value">
  <column label="{label}" gap="12">
    <slot/>
    <row gap="4" cross="center">
      <text>{value}</text>
      <spacer grow="1"/>
      <button variant="ghost" size="icon" icon="chevron-left" label="Previous slide" on-press="previous_page" disabled="{at_first}"></button>
      <button variant="ghost" size="icon" icon="chevron-right" label="Next slide" on-press="next_page" disabled="{at_last}"></button>
      <spacer grow="1"/>
    </row>
  </column>
</template>
