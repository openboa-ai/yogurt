<template name="yg-composer" args="label value attachment_detail= tool_label=Tools">
  <card padding="12">
    <column gap="8">
      <for each="composer_attachments" key="id" as="item">
        <row gap="8" cross="center" padding="8" background="surface_subtle" radius="md">
          <column grow="1" gap="0">
            <text>{item.title}</text>
            <text size="sm" foreground="text_muted">{attachment_detail}</text>
          </column>
          <button variant="ghost" size="icon" icon="x" label="{'Remove ' ++ item.title}" on-press="remove_attachment:{item.id}"/>
        </row>
      </for>
      <textarea size="lg" label="{label}" placeholder="{label}" text="{value}" height="56" background="background" on-input="draft_changed"/>
      <row gap="8" cross="center">
        <if test="{composer_can_attach}"><button variant="ghost" on-press="choose_attachment">Attach</button></if>
        <if test="{composer_can_choose_tool}"><button variant="secondary" icon="chevron-down" icon-placement="trailing" on-press="choose_tool">{tool_label}</button></if>
        <spacer grow="1"/>
        <if test="{composer_pending}"><if test="{composer_can_stop}"><button variant="secondary" on-press="stop_response">Stop response</button></if></if>
        <else><button variant="primary" width="88" disabled="{composer_send_disabled}" on-press="send_message">Send</button></else>
      </row>
    </column>
  </card>
</template>
