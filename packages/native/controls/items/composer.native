<template name="yg-composer" args="label value">
  <card padding="12">
    <column gap="8">
      <for each="composer_attachments" key="id" as="item">
        <row gap="8" cross="center">
          <text grow="1">{item.title}</text>
          <button variant="ghost" label="{'Remove ' ++ item.title}" on-press="remove_attachment:{item.id}">Remove</button>
        </row>
      </for>
      <textarea label="{label}" text="{value}" background="surface" on-input="draft_changed"/>
      <row gap="8" cross="center">
        <if test="{composer_can_attach}"><button variant="ghost" on-press="choose_attachment">Attach a file</button></if>
        <if test="{composer_can_choose_tool}"><button variant="ghost" on-press="choose_tool">Choose tool</button></if>
        <spacer grow="1"/>
        <if test="{composer_pending}"><if test="{composer_can_stop}"><button variant="secondary" on-press="stop_response">Stop response</button></if></if>
        <else><button variant="primary" disabled="{composer_send_disabled}" on-press="send_message">Send</button></else>
      </row>
    </column>
  </card>
</template>
