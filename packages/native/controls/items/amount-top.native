<template name="yg-amount-top" args="label value detail">
  <column gap="4">
    <text size="sm" foreground="text_muted">{label}</text>
    <text size="heading"><span scale="1.7">{value}</span></text>
    <text size="sm" foreground="text_muted"><span scale="0.923076923">{detail}</span></text>
  </column>
</template>
