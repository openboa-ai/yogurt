<template name="yg-confirm-dialog" args="title consequence choice">
  <dialog label="{title}" on-dismiss="dismiss">
  <column gap="12" padding="16">
  <text size="heading">{title}</text>
  <text>{consequence}</text>
  <row gap="8">
  <button variant="ghost" on-press="dismiss">Cancel</button>
  <button disabled="{unavailable}" variant="destructive" on-press="confirm_current">{choice}</button>
  </row>
  </column>
  </dialog>
</template>
