<template name="yg-drawer" args="title footer=true">
  <drawer label="{title}" on-dismiss="dismiss" padding="24">
    <row main="center">
      <column gap="12" grow="1" max-width="496">
        <row gap="8" cross="center">
          <text size="heading" grow="1" wrap="true">{title}</text>
          <button variant="ghost" size="icon" icon="x" label="Close" on-press="dismiss"/>
        </row>
        <slot/>
        <if test="{footer}"><button variant="ghost" on-press="dismiss">Close</button></if>
      </column>
    </row>
  </drawer>
</template>
