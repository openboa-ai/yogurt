<template name="yg-agreement" args="label">
  <column gap="8">
    <text>{label}</text>
    <checkbox checked="{all_checked}" on-toggle="toggle_all">Select all</checkbox>
    <for each="choices" key="id" as="item">
      <checkbox checked="{item.selected}" disabled="{item.disabled}" on-toggle="choose:{item.id}">{item.title}</checkbox>
    </for>
  </column>
</template>
