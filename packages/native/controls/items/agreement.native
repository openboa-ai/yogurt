<template name="yg-agreement" args="label">
  <column gap="8">
    <text size="sm">{label}</text>
    <checkbox key="{'all-' ++ all_checked}" checked="{all_checked}" on-toggle="toggle_all">Select all</checkbox>
    <row>
      <spacer width="12"/>
      <column grow="1" gap="8">
        <for each="choices" key="id" as="item">
          <checkbox key="{'choice-' ++ item.id ++ '-' ++ item.selected}" checked="{item.selected}" disabled="{item.disabled}" on-toggle="choose:{item.id}">{item.title}</checkbox>
        </for>
      </column>
    </row>
  </column>
</template>
