<template name="yg-calendar" args="label">
  <column gap="8">
    <text size="sm">{label}</text>
    <column gap="8">
      <row gap="8" cross="center">
        <button variant="ghost" on-press="previous_page">Previous</button>
        <text>{month_label}</text>
        <button variant="ghost" on-press="next_page">Next</button>
      </row>
      <grid columns="7" gap="2">
        <for each="days" key="id" as="item">
          <toggle-button selected="{item.selected}" disabled="{item.disabled}" on-toggle="choose:{item.id}">{item.title}</toggle-button>
        </for>
      </grid>
    </column>
  </column>
</template>
