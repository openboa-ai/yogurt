<template name="yg-questionnaire" args="title detail">
  <column gap="8">
    <text size="heading">{title}</text>
    <text size="sm">{detail}</text>
    <slot/>
    <row gap="8" cross="center">
      <button variant="ghost" on-press="previous_page" disabled="{at_first}">Back</button>
      <button variant="ghost" on-press="next_page" disabled="{unavailable}">Continue</button>
    </row>
  </column>
</template>
