<import src="resource-row.native"/>
<import src="thread-row.native"/>
<import src="composer.native"/>
<template name="yg-project-workspace">
  <column gap="@{gap-stack}">
    <if test="{project_picker_open}">
      <text size="heading">Projects</text>
      <search-field label="Search projects" text="{project_picker_query}" on-input="change_project_picker_query"/>
      <if test="{projects_available}">
        <list label="Projects">
          <for each="projects" key="id" as="item">
            <list-item selected="{item.selected}" disabled="{item.disabled}" on-press="select_project:{item.id}">{item.title}</list-item>
          </for>
        </list>
      </if>
      <else>
        <text foreground="text_muted">No projects match.</text>
        <button variant="ghost" on-press="clear_project_picker_query">Clear search</button>
      </else>
      <button variant="ghost" on-press="close_project_picker">Close projects</button>
    </if>
    <else>
      <button variant="ghost" on-press="open_project_picker">Choose project</button>
      <if test="{project_available}">
        <row gap="@{gap-inline}" cross="center">
          <image label="Project mark" image="{project_image}" width="32" height="32"/>
          <text size="heading">{project_name}</text>
        </row>
        <if test="{can_share_project}"><button variant="ghost" on-press="share_project">Share project</button></if>
        <tabs label="Project sections">
          <toggle-button selected="{project_chats_active}" on-toggle="show_project_chats">Chats</toggle-button>
          <toggle-button selected="{project_sources_active}" on-toggle="show_project_sources">Sources</toggle-button>
          <toggle-button selected="{project_instructions_active}" on-toggle="show_project_instructions">Instructions</toggle-button>
        </tabs>
        <if test="{project_chats_active}">
          <if test="{can_start_project_chat}"><button variant="secondary" on-press="start_project_chat">New chat</button></if>
          <if test="{project_composer_visible}"><use template="yg-composer" label="{'New message in ' ++ project_name}" value="{project_draft}"/></if>
          <search-field label="Find project chats" text="{project_query}" on-input="change_project_query"/>
          <if test="{project_threads_available}">
            <list label="Project chats">
              <for each="project_threads" key="id" as="item">
                <use template="yg-thread-row" label="{item.title}" detail="{item.detail}" summary="{item.summary}" item_id="{item.id}" selected="{item.selected}" unread="{item.unread}" disabled="{item.disabled}"/>
              </for>
            </list>
          </if>
          <else>
            <text foreground="text_muted">No chats match this view.</text>
            <button variant="ghost" on-press="clear_project_query">Clear search</button>
          </else>
        </if>
        <if test="{project_sources_active}">
          <if test="{can_add_project_source}"><button variant="secondary" on-press="add_project_source">Add source</button></if>
          <search-field label="Find project sources" text="{project_query}" on-input="change_project_query"/>
          <if test="{project_sources_available}">
            <column label="Project sources" gap="@{gap-inline}">
              <for each="project_sources" key="id" as="item">
                <use template="yg-resource-row" label="{item.title}" detail="{item.detail}" summary="{item.summary}" item_id="{item.id}" selected="{item.selected}" disabled="{item.disabled}" pinned="{item.pinned}" can_pin="{item.can_pin}"/>
              </for>
            </column>
          </if>
          <else>
            <text foreground="text_muted">No sources match this view.</text>
            <button variant="ghost" on-press="clear_project_query">Clear search</button>
          </else>
        </if>
        <if test="{project_instructions_active}">
          <text size="heading">Project instructions</text>
          <text>{project_instructions}</text>
          <if test="{can_edit_project_instructions}"><button variant="secondary" on-press="edit_project_instructions">Edit instructions</button></if>
        </if>
      </if>
      <else><text foreground="text_muted">Choose an available project to see its chats and sources.</text></else>
    </else>
  </column>
</template>
