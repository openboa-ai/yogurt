<import src="record-facts.native"/>
<import src="table-row.native"/>
<import src="confirm-dialog.native"/>
<template name="yg-decision-review">
  <column gap="@{gap-panel}">
    <use template="yg-record-facts" title="{title}" source="{source}" as_of="{as_of}"><column gap="@{gap-inline}"><for each="facts" key="id" as="item"><use template="yg-table-row" label="{item.title}" value="{item.detail}"/></for></column></use>
    <button variant="secondary" disabled="{unavailable}" on-press="open_choices">{action_label}</button>
    <if test="{is_open}"><use template="yg-confirm-dialog" title="{title}" consequence="{consequence}" choice="{action_label}"/></if>
  </column>
</template>
