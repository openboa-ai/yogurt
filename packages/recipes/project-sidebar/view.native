<import src="sidebar-layout.native"/>
<template name="yg-project-sidebar">
  <column>
    <use template="yg-sidebar-panel" label="Project navigation">
      <row gap="8" cross="center">
        <image label="Project mark" image="{project_image}" width="24" height="24"/>
        <text size="heading">{project_name}</text>
      </row>
      <search-field label="Find a view" text="{sidebar_query}" on-input="search_sidebar"/>
      <stack grow="1">
        <column height="160"/>
        <scroll label="Project views">
          <use template="yg-sidebar-group" label="Workspace">
            <if test="{sidebar_group_open}"><list-item icon="chevron-down" on-press="toggle_sidebar_group">Project views</list-item></if>
            <else><list-item icon="chevron-right" on-press="toggle_sidebar_group">Project views</list-item></else>
            <if test="{sidebar_group_open}">
              <row>
                <spacer width="32"/>
                <column grow="1">
                  <use template="yg-sidebar-items">
                    <for each="sidebar_destinations" key="id" as="item">
                      <use template="yg-sidebar-destination" label="{item.title}" item_id="{item.id}" selected="{item.selected}">
                        <text>{item.title}</text>
                      </use>
                    </for>
                  </use>
                </column>
              </row>
            </if>
          </use>
        </scroll>
      </stack>
      <if test="{sidebar_can_add}"><button variant="secondary" on-press="add_sidebar_item">Add project view</button></if>
    </use>
  </column>
</template>
