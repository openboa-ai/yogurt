<import src="sidebar-layout.native"/>
<template name="yg-agent-sidebar">
  <column>
    <use template="yg-sidebar-panel" label="Agents">
      <text size="heading">Agents</text>
      <search-field label="Find an agent" text="{sidebar_query}" on-input="search_sidebar"/>
      <stack grow="1">
        <column height="160"/>
        <scroll label="Agent list">
          <use template="yg-sidebar-group" label="Team">
            <row>
              <spacer width="12"/>
              <column grow="1">
                <list gap="@{space.2}">
                  <for each="sidebar_destinations" key="id" as="item">
                    <use template="yg-sidebar-destination" label="{item.title}" item_id="{item.id}" selected="{item.selected}">
                      <row gap="@{gap-inline}" cross="center">
                        <image label="Agent silhouette" image="{item.image_id}" width="24" height="24"/>
                        <text>{item.title}</text>
                        <if test="{item.unread}"><text size="sm">Unread</text></if>
                      </row>
                    </use>
                  </for>
                </list>
              </column>
            </row>
          </use>
        </scroll>
      </stack>
      <column><if test="{sidebar_can_add}"><button variant="secondary" on-press="add_sidebar_item">New conversation</button></if></column>
    </use>
  </column>
</template>
