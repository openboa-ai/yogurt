<import src="switch.native"/>
<import src="select.native"/>
<template name="yg-project-settings">
  <column gap="@{gap-panel}">
    <text size="heading">Project settings</text>
    <column key="{'digest-' ++ enabled}"><use template="yg-switch" label="Send a digest" checked="{enabled}"/></column>
    <if test="{enabled}"><use template="yg-select-picker" label="Frequency" value="{value}" expanded="{is_open}">
      <column><for each="choices" key="id" as="item"><menu-item selected="{item.selected}" disabled="{item.disabled}" on-press="choose:{item.id}">{item.title}</menu-item></for></column>
    </use></if>
    <row gap="@{gap-inline}"><button disabled="{unavailable}" on-press="activate">Save changes</button><button variant="ghost" disabled="{unavailable}" on-press="discard">Discard</button></row>
  </column>
</template>
