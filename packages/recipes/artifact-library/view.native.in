<import src="resource-row.native"/>
<template name="yg-artifact-library">
  <column gap="@{gap-stack}">
    <text size="heading">Artifacts</text>
    <search-field label="Search artifacts" text="{artifact_query}" on-input="change_artifact_query"/>
    <stack>
      <select label="Artifact types" text="{artifact_filter}" on-press="open_artifact_filters"/>
      <if test="{artifact_filters_open}">
        <dropdown-menu anchor="below" anchor-alignment="stretch" label="Artifact types" on-dismiss="close_artifact_filters">
          <for each="artifact_filters" key="id" as="item">
            <menu-item selected="{item.selected}" on-press="select_artifact_filter:{item.id}">{item.title}</menu-item>
          </for>
        </dropdown-menu>
      </if>
    </stack>
    <if test="{artifact_loading}"><status-bar>Loading artifacts</status-bar></if>
    <else>
      <if test="{artifact_has_results}">
        <for each="artifacts" key="id" as="item">
          <use template="yg-resource-row" label="{item.title}" detail="{item.detail}" summary="{item.summary}" item_id="{item.id}" selected="{item.selected}" disabled="{item.disabled}" pinned="{item.pinned}" can_pin="{item.can_pin}"/>
        </for>
      </if>
      <else>
        <text foreground="text_muted">No artifacts match this view.</text>
        <button variant="ghost" on-press="clear_artifact_filters">Reset filters</button>
      </else>
    </else>
    <if test="{artifact_preview_open}">
      <panel padding="@{inset-regular}">
        <column gap="@{gap-inline}">
          <text size="heading">{artifact_preview_title}</text>
          <text>{artifact_preview_detail}</text>
          <if test="{artifact_can_download}"><button variant="secondary" on-press="download_artifact:{artifact_preview_id}">Download</button></if>
          <button variant="ghost" on-press="close_artifact_preview">Close preview</button>
        </column>
      </panel>
    </if>
  </column>
</template>
