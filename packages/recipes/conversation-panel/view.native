<import src="message.native"/>
<import src="textarea.native"/>
<import src="transcript.native"/>
<template name="yg-conversation-panel">
  <column gap="16">
    <use template="yg-transcript" label="Conversation"><column gap="12"><for each="events" key="id" as="item"><use template="yg-message" speaker="{item.title}" content="{item.detail}"/></for></column></use>
    <use template="yg-textarea" label="Message" value="{value}"/>
    <row gap="8"><button disabled="{unavailable}" on-press="activate">Send</button><if test="{pending}"><button variant="ghost" on-press="stop">Stop</button></if></row>
  </column>
</template>
