<import src="yogurt/items/bar-chart.native"/>
<import src="yogurt/items/data-table.native"/>
<import src="yogurt/items/result.native"/>
<column background="background" padding="24" gap="16">
  <text size="heading">Reading board</text>
  <if test="{can_read}">
    <column gap="12">
      <text size="heading">Room 4</text>
      <text size="sm" foreground="text_muted">Two of three readings available</text>
      <use template="yg-bar-chart" label="Room 4 readings" source="Monitoring log · 13:00 UTC"/>
      <button variant="secondary" on-press="open_readings">View readings</button>
      <if test="{show_readings}">
        <use template="yg-data-table" label="Room 4 readings">
          <table-row><table-cell>Time</table-cell><table-cell>mg</table-cell></table-row>
          <for each="reading_rows" key="id" as="item">
            <table-row><table-cell>{item.time}</table-cell><table-cell>{item.value}</table-cell></table-row>
          </for>
        </use>
      </if>
      <button variant="ghost" on-press="withdraw_access">Withdraw fixture access</button>
    </column>
  </if>
  <else><use template="yg-result" title="Record unavailable" detail="Access to the readings could not be confirmed."/></else>
</column>
