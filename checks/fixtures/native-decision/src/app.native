<import src="yogurt/items/confirm-dialog.native"/>
<import src="yogurt/items/receipt.native"/>
<import src="yogurt/items/progress.native"/>
<import src="yogurt/items/record-facts.native"/>
<column background="background" padding="24" gap="16">
  <text size="heading">Editorial review</text>
  <if test="{show_list}">
    <column gap="12">
      <button variant="secondary" on-press="select_a">Review Brief A</button>
      <button variant="secondary" on-press="select_b">Review Brief B</button>
    </column>
  </if>
  <if test="{show_record}">
    <column gap="16">
      <use template="yg-record-facts" title="{brief_name}" source="Editorial register" as_of="09:15 UTC">
        <text>{revision_name}</text>
      </use>
      <use template="yg-progress" label="{progress_label}" amount="{progress_amount}"/>
      <if test="{can_submit}">
        <button variant="destructive" on-press="open_choices">Return for revision</button>
      </if>
      <if test="{has_receipt}">
        <use template="yg-receipt" title="{receipt_title}" original_id="{receipt_id}" detail="{receipt_detail}"/>
      </if>
      <button variant="ghost" on-press="close_record">Back to briefs</button>
    </column>
  </if>
  <if test="{dialog_open}">
    <use template="yg-confirm-dialog" title="Return this brief?" consequence="The editor will receive the selected brief for revision." choice="Return for revision"/>
  </if>
  <text size="sm" foreground="text_muted">{submission_label}</text>
</column>
