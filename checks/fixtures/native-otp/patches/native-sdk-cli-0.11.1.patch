+fn emitEmptyFocusCell(builder: *Builder, widget: Widget, tokens: DesignTokens, radius: Radius) Error!void {
+    const cell = widget.style.empty_focus_cell orelse return;
+    if (!widget.state.focused or widget.text.len != 0 or cell.count == 0) return;
+    const width = @min(cell.width, (widget.frame.width - cell.remaining_gap) / @as(f32, @floatFromInt(cell.count)));
+    if (width <= 0) return;
+    try builder.fillRoundedRect(.{
+        .id = ownedWidgetPartId(tokens, widget.id, 17),
+        .rect = geometry.RectF.init(widget.frame.x, widget.frame.y, width, widget.frame.height),
+        .radius = radius,
+        .fill = colorFill(tokens.colors.surface_pressed),
+    });
