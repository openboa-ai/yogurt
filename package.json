{
  "name": "@openboa/yogurt",
  "version": "0.2.0-local.1",
  "private": true,
  "description": "OpenBoa interface components, design tokens and original artwork.",
  "type": "module",
  "files": [
    "packages/web/dist",
    "design/tokens",
    "design/assets/fonts/rethink-sans/*.woff2",
    "design/assets/fonts/rethink-sans/OFL.txt",
    "design/assets/logo/upright-9.svg",
    "design/assets/projects/*.svg",
    "design/assets/agents/*.svg",
    "design/assets/agents/animation-fits.json",
    "apps/guide/generated/agents.html",
    "design/styles/ui*.css",
    "design/styles/tokens.css",
    "packages/web/README.md",
    "bin",
    "catalog/components.json",
    "catalog/motion-components.json",
    "catalog/patterns.json",
    "catalog/blocks.json",
    "catalog/motion.json",
    "packages/recipes",
    "catalog/brand.json",
    "design/content/agent-names.json",
    "design/content/terms.json",
    "registry",
    "design/assets/logo/openboa-lockup.svg",
    "design/assets/logo/openboa-wordmark.svg",
    "design/assets/projects/emoji.json",
    "design/assets/agents/silhouettes.json",
    "design/assets/agents/eye-motion.json",
    "design/assets/agents/presence-motion.json",
    "design/assets/agents/avatar-motion.json",
    "DESIGN.md",
    "scripts/describe-pattern.mjs",
    "docs/native-stack.md",
    "docs/engineering/renderers/react-ui/spec.md",
    "docs/using-yogurt.md",
    "docs/motion.md",
    "apps/guide/generated/components.html",
    "docs/engineering/controls/component-library",
    "docs/workspace-patterns.md",
    "docs/sidebar.md",
    "docs/design-system-rules.md",
    "docs/screen-composition.md",
    "docs/component-composition.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./apps/guide/**"
  ],
  "exports": {
    ".": {
      "types": "./packages/web/dist/index.d.ts",
      "import": "./packages/web/dist/index.js"
    },
    "./web": {
      "types": "./packages/web/dist/index.d.ts",
      "import": "./packages/web/dist/index.js"
    },
    "./*": {
      "types": "./packages/web/dist/entries/*.d.ts",
      "import": "./packages/web/dist/entries/*.js"
    },
    "./motion-patterns": {
      "types": "./packages/web/dist/patterns/motion-patterns.d.ts",
      "import": "./packages/web/dist/motion-patterns.js"
    },
    "./agent": {
      "types": "./packages/web/dist/agent.d.ts",
      "import": "./packages/web/dist/agent.js"
    },
    "./agent-names": "./design/content/agent-names.json",
    "./styles.css": "./design/styles/ui.css",
    "./tokens": "./design/tokens/ui.json",
    "./palette": "./design/tokens/brand.json",
    "./art/*": "./design/assets/*",
    "./brand": "./catalog/brand.json",
    "./terms": "./design/content/terms.json",
    "./blocks": "./catalog/blocks.json"
  },
  "scripts": {
    "tokens": "node scripts/tokens/generate.mjs",
    "check:tokens": "node scripts/tokens/generate.mjs --check",
    "build": "node scripts/build-ui.mjs",
    "guide:dev": "npm run build && node apps/guide/tooling/build-site.mjs --static-only && vite --config apps/guide/vite.config.mjs",
    "guide:build": "npm run build && vite build --config apps/guide/vite.config.mjs && node apps/guide/tooling/build-site.mjs",
    "guide:preview": "vite preview --config apps/guide/vite.config.mjs --outDir ../../../site",
    "gallery": "node scripts/build-ui-gallery.mjs",
    "gallery:agents": "node scripts/build-ui-gallery.mjs --agents",
    "check:agents": "node checks/agent-family.mjs && node checks/web-agent-family.cjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:web": "node scripts/run-web-checks.mjs"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13"
  },
  "peerDependencies": {
    "react": ">=19.2.0 <20",
    "react-dom": ">=19.2.0 <20"
  },
  "devDependencies": {
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1",
    "react": "19.2.0",
    "react-day-picker": "9.11.1",
    "react-dom": "19.2.0",
    "react-resizable-panels": "3.0.6",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "bin": {
    "yogurt": "./bin/yogurt.mjs"
  }
}
