<import src="yogurt/items/button.native"/>
<import src="yogurt/items/switch.native"/>
<column background="background">
  <scroll grow="1" label="Saved view content">
  <column gap="16" padding="24">
  <row gap="8" cross="center">
    <text grow="1" size="heading">Saved view</text>
    <button variant="ghost" on-press="change_material">Change surface</button>
  </row>
  <column background="surface" radius="lg" padding="16" gap="12">
    <text size="sm" foreground="text_muted">Sourdough</text>
    <text size="heading">Weekly review</text>
    <row gap="8" cross="center">
      <use template="yg-button" label="Save view"/>
      <button variant="secondary" on-press="undo">Undo</button>
    </row>
    <text>{save_status}</text>
    <use template="yg-switch" checked="{dates}" label="Record dates"/>
    <if test="{dates}"><text size="sm" foreground="text_muted">Friday, November 20</text></if>
  </column>
  <row height="44" gap="12" cross="center" on-press="toggle_dark"><text grow="1">Dark appearance</text><switch width="32" height="19" label="Dark appearance" checked="{dark}" on-toggle="toggle_dark"/></row>
  <text size="sm" foreground="text_muted">{material_name}</text>
  </column>
  </scroll>
</column>
